# URL of the backend API.
# Development: leave as /api (Vite proxies it to the backend, see vite.config.js).
# Production (Vercel): set to your Railway URL, e.g. https://your-api.up.railway.app/api
VITE_API_URL=/api

# Where the backend runs in development. Change this only if you changed PORT in backend/.env.
VITE_PROXY_TARGET=http://localhost:5050
