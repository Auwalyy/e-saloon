# ----------------------------------------------------------------------------
# Aisha's Salon API - environment variables
# Copy this file to ".env" and fill in the values. Never commit ".env".
# ----------------------------------------------------------------------------

NODE_ENV=development
PORT=5050

# --- Database ---------------------------------------------------------------
# Local MongoDB, or a MongoDB Atlas connection string in production.
# If this is left out in development and no local MongoDB is running, the API
# starts on a temporary in-memory database with demo data (lost on restart).
MONGODB_URI=mongodb://127.0.0.1:27017/esalon
# Set to true to always use the temporary in-memory database.
USE_MEMORY_DB=false
# In development, an empty database is filled with demo data on start.
AUTO_SEED=true

# --- Authentication ---------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string_of_at_least_32_characters
JWT_EXPIRES_IN=7d
JWT_COOKIE_EXPIRES=7

# --- Frontend ---------------------------------------------------------------
# Allowed browser origin(s) for CORS. Comma separated; the first one is used in email links.
FRONTEND_URL=http://localhost:5173

# --- First administrator (created automatically when no admin exists) ------
ADMIN_NAME=Aisha Bello
ADMIN_EMAIL=admin@aishasalon.com
ADMIN_PASSWORD=Admin@123456

# --- Email (optional) -------------------------------------------------------
# Leave blank in development: emails are logged to the console instead of sent.
# For Gmail use an "App password", not your normal password.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=Aisha's Salon <noreply@aishasalon.com>

# --- Online payments (optional) ---------------------------------------------
# Leave blank to offer "pay at the salon" only. Add Paystack keys to enable card payments.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# --- Misc -------------------------------------------------------------------
SALON_TIMEZONE=Africa/Lagos
# SMS gateway to use. "console" logs messages; register a real provider in services/sms.service.js.
SMS_PROVIDER=console
