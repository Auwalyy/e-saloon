# Email (Gmail)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
EMAIL_FROM=Aisha's Salon <noreply@aishasalon.com>

# Paystack
PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret
